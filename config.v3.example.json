{
  "usp_controller": {
    "transport_protocol": "stomp",
    "broker_host": "127.0.0.1",
    "broker_port": 61614,
    "username": "guest",
    "password": "guest",
    "controller_endpoint_id": "proto::controller.default",
    "receive_topic": "/queue/usp.controller.default",
    "devices_file": "devices.json",
    "debug_level": 0,
    "enable_mdns_discovery": true,
    "auto_register_devices": true,
    "mdns_scan_interval": 60,
    "heartbeat_check_enabled": true,
    "heartbeat_check_interval": 60,
    "device_timeout": 300,
    "heartbeat_check_path": "Device.DeviceInfo.UpTime",
    "transport_extra": {
      "heartbeat": "0,0",
      "timeout": 10
    }
  },
  "ipc": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 6001,
    "timeout": 30.0
  },
  "scripting": {
    "intelligence_level": 2,
    "auto_discovery": true,
    "auto_retry": true,
    "max_retries": 3,
    "scripts_dir": "scripts"
  },
  "mini_broker": {
    "enable": true,
    "host": "0.0.0.0",
    "port": 61614
  }
}
